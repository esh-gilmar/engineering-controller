{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-policy.schema.json",
  "title": "engineering-controller Project Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protected_paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "forbidden_commands": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "human_required_flags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "max_same_gate": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_total_reviews": {"type": "integer", "minimum": 1, "maximum": 6}
  }
}
